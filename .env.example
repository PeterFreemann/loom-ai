# Required: powers the AI builder
ANTHROPIC_API_KEY=
# Optional: override the model
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional server-side fallbacks. Users can also paste their own tokens in the UI.
# GitHub fine-grained token with "Contents" + "Administration" (read/write) + "Pages" permissions
GITHUB_TOKEN=
# Vercel token from https://vercel.com/account/tokens
VERCEL_TOKEN=
# Optional: deploy into a Vercel team
VERCEL_TEAM_ID=
